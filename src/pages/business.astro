---
import BaseLayout from "../layouts/BaseLayout.astro";
import businessMain from "../legacy/business-main.html?raw";

const title = "Bytewise Technologies | Business Solutions";
const description = "ICT solutions for growing businesses: multi-location POS and inventory, custom CRM and sales portals, and automated accounting integration.";
---

<BaseLayout
  title={title}
  description={description}
  page={"services"}
  bodyClass={"business-page home-page--neo business-page--neo"}
>
  <div set:html={businessMain} />
</BaseLayout>
