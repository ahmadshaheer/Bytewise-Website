---
const navPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isServicesSection = ["/services", "/business", "/ngo", "/government"].includes(
  navPath
);
---

<header class="site-header sticky-top">
  <nav class="navbar navbar-expand-xl">
    <div class="container-xxl neo-nav-wrap">
      <a href="/" class="brand-link navbar-brand p-0 m-0">
        <span class="brand-mark brand-mark--image">
          <img src="/assets/bytewise-logo.png" alt="Bytewise Technologies logo" />
        </span>
        <span>
          <span class="brand-name">Bytewise Technologies</span>
          <span class="brand-tagline d-block"
            >Software, ERP, Infrastructure &amp; IT Consulting</span
          >
        </span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#siteNav"
        aria-controls="siteNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="siteNav">
        <ul class="navbar-nav mx-auto align-items-xl-center gap-xl-2 site-nav">
          <li class="nav-item">
            <a
              class:list={["nav-link", { active: navPath === "/" }]}
              href="/">Home</a
            >
          </li>
          <li class="nav-item dropdown">
            <a
              class:list={["nav-link dropdown-toggle", { active: isServicesSection }]}
              href="/services/"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              Services
            </a>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item" href="/services/">All Services</a>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a
                  class:list={[
                    "dropdown-item",
                    { active: navPath === "/business" },
                  ]}
                  href="/business/">Business</a
                >
              </li>
              <li>
                <a
                  class:list={["dropdown-item", { active: navPath === "/ngo" }]}
                  href="/ngo/">NGOs</a
                >
              </li>
              <li>
                <a
                  class:list={[
                    "dropdown-item",
                    { active: navPath === "/government" },
                  ]}
                  href="/government/">Government</a
                >
              </li>
            </ul>
          </li>
          <li class="nav-item">
            <a
              class:list={["nav-link", { active: navPath === "/projects" }]}
              href="/projects/">Projects</a
            >
          </li>
        </ul>
        <div class="header-actions">
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Switch to dark mode"
            aria-pressed="false"
          >
            <svg
              class="theme-toggle__icon theme-toggle__icon--sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              class="theme-toggle__icon theme-toggle__icon--moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <a href="/contact/" class="btn btn-brand neo-header-cta">Contact Us</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<a href="/contact/" class="neo-floating-contact d-none d-lg-inline-flex"
  >Contact Us</a
>
